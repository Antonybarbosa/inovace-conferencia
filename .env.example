# Variáveis usadas pelo docker-compose.yml (raiz do projeto).
# Este arquivo é opcional: o compose já tem defaults que funcionam.
#
# Porta do host que serve o frontend. Padrão: 8080.
# O padrão não é 80 porque no servidor de deploy essa porta é ocupada
# por outro serviço (Zabbix).
FRONTEND_PORT=8080
